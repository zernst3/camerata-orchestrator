# Camerata local config template. Copy to `.env` (gitignored) and fill in.
# The app auto-loads `.env` at startup (run from the repo dir).

# GitHub PAT (classic, full scope is fine) — enables scan / adopt / arm / emit /
# reconcile / tickets. Without it the app runs on the built-in native tracker.
CAMERATA_GITHUB_TOKEN=

# ── AI model access ──────────────────────────────────────────────────────────
# Camerata's AI steps (brownfield audit, investigation, clarifications, code-gen,
# research chat) call models through ONE vendor-agnostic seam.
# Vendor: which provider. anthropic is wired today; openai/google are reserved
# (selecting them returns a clear "not wired yet" until their arm is added).
CAMERATA_LLM_VENDOR=anthropic
# Transport for a vendor that offers both:
#   api: calls the vendor's HTTP API under its commercial terms (needs the key below).
#        The default, and the only backend client work may use.
#   cli: shells out to the vendor's CLI on your own login (no key). For the maintainer's
#        own development only: never for client code. Client engagements refuse it.
CAMERATA_LLM_BACKEND=api
# Required when CAMERATA_LLM_BACKEND=api.
ANTHROPIC_API_KEY=
# Default model id for calls that name none (the cockpit chat, ad hoc tools). An inspection
# never falls back to it: its stages use --model, else CAMERATA_AUDIT_MODEL, else the
# registry default, the same model the pre-flight prices. Use an id the model registry
# prices (crates/llm/src/model_registry.rs), or a spend limit cannot count its calls.
CAMERATA_LLM_MODEL=claude-sonnet-5

# Optional: the default repo the background poller watches for PO comments.
CAMERATA_GITHUB_REPO=

# Optional: GitHub Projects v2 board (for `cargo run -p camerata -- projects-live`).
# CAMERATA_GITHUB_PROJECT_OWNER=
# CAMERATA_GITHUB_PROJECT_NUMBER=
# CAMERATA_GITHUB_PROJECT_KIND=user

# Optional: run a REAL claude -p fleet (otherwise runs are scripted/token-free).
# CAMERATA_LIVE_BUILD=1

# Optional poller cadences (defaults shown).
# CAMERATA_POLL_TRACKER_SECS=45
# CAMERATA_POLL_DEPLOY_SECS=5
# CAMERATA_UI_NOTIFY_SECS=5
